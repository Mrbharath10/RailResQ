# RailResQ Environment Configuration
PROJECT_NAME="RailResQ - Railway Emergency Coordination System"
VERSION="1.0.0-phase1"
ENVIRONMENT="development"

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Secrets (Will be used in Phase 5)
SECRET_KEY="temporary-dev-secret-key-change-in-production-must-be-random-hex"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Will be used in Phase 4)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/railresq_db"
# Fallback local sqlite for easy demonstration without local postgres installation:
# DATABASE_URL="sqlite:///./railresq.db"

# LLM API Configuration (Will be used in Phase 7)
GEMINI_API_KEY=""
